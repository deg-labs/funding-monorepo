# ===== Server (fetcher / api) =====

# 取引所の選択です。bybit または bitget を指定します。
EXCHANGE=bybit

# Bitget を利用する場合の商品タイプです。
BITGET_PRODUCT_TYPE=usdt-futures

# 収集サイクルの間隔（秒）です。
FETCH_INTERVAL_SECONDS=300

# 同時に実行する取引所リクエスト数です。
CONCURRENCY_LIMIT=10

# 異常候補としてログに記録する Funding Rate の閾値（絶対値）です。
FUNDING_RATE_THRESHOLD=0.001

# 初回取得と欠損補完で取得する履歴件数です。
FUNDING_RATE_HISTORY_LIMIT=200

# 通常サイクルで取得する履歴件数です。
INCREMENTAL_HISTORY_LIMIT=10

# 取引所 API の設定です。
BYBIT_BASE_URL=https://api.bybit.com
BITGET_BASE_URL=https://api.bitget.com
REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRY_MAX=3
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# SQLite と API サーバーの設定です。
DB_PATH=/app/data/cmma.db
HTTP_ADDR=:8000
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
DB_MAX_OPEN_CONNS=4

# ログ設定です。LOG_FORMAT は json または text を指定します。
LOG_FORMAT=json
LOG_LEVEL=info

# ===== Client notifier =====

# 必須です。
DISCORD_WEBHOOK_URL=

# Compose のサービス名で API を参照します。
CMMA_API_BASE_URL=http://nginx

FUNDING_RATE_DIRECTION=both
FUNDING_RATE_SORT=funding_abs_desc
FUNDING_RATE_LIMIT=100
FUNDING_RATE_LOOKBACK=24
MAX_NOTIFICATIONS=20
RENOTIFY_BUFFER_MINUTES=240
CHECK_INTERVAL_SECONDS=300
LOG_MAX_SIZE_MB=10
